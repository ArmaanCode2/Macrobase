<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 8.0 and 8.1. These versions cannot tell cloud backup from device transfer, so nothing
    is backed up: personal data never goes to Google's cloud backup (BUG-018).
    Android 9 to 11 use xml-v28/backup_rules.xml; Android 12+ use data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
