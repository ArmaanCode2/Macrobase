<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's Mentor background: a near-black card, a faint green wash from the top left, and a green hairline -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0B0F0C" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#006EE682"
                android:startColor="#176EE682"
                android:type="linear" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="#2496FFAA" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
